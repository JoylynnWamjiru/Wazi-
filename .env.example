# Wazi — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository.

# --- DeepSeek (LLM) ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic (optional fallback) ---
ANTHROPIC_API_KEY=your_key_here

# --- PostgreSQL ---
DATABASE_URL=postgresql://wazi:wazi_password@localhost:5432/wazi_db

# --- Messaging provider (Africa's Talking OR Twilio) ---
# "africastalking" (default) or "twilio"
MESSAGING_PROVIDER=africastalking

# --- Africa's Talking ---
AT_API_KEY=your-at-api-key
AT_USERNAME=sandbox
WA_BOT_NUMBER=+254700000000

# --- Twilio (used when MESSAGING_PROVIDER=twilio) ---
# From console.twilio.com: Account SID (AC...), Auth Token, and the
# WhatsApp sandbox/number ("whatsapp:+14155238886").
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Optional: the exact public URL Twilio posts to, if your app is behind a
# proxy and can't reconstruct the signed URL (scheme + host + path).
# TWILIO_WEBHOOK_BASE_URL=https://your-domain.com/whatsapp/incoming

# --- Identity Hashing ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ID_SALT=replace-with-secrets-token-hex-32-output

# --- Admin Dashboard ---
ADMIN_PASSWORD=change-me-to-something-strong

# --- Retention ---
CHAT_RETENTION_DAYS=90
DISPUTE_RETENTION_DAYS=365
